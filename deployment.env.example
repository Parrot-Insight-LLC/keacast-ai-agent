# Deployment Environment Configuration
# Copy this file to .env and update with your actual values

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5001

# CORS Configuration (comma-separated; spaces are trimmed).
# Production also always allows http://localhost:4200 for local Angular.
# Do not use *.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_API_KEY=your-api-key-here

# Redis Configuration
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Cashflow-backend session JWT (required for POST /api/agent/chat and user cache routes).
# Must match cashflow-backend-api config.keyword (process.env.key_word).
# Do NOT reuse JWT_SECRET — that is only for unused /api/auth/login.
CASHFLOW_JWT_SECRET=your-cashflow-key_word-value

# Optional: Database Configuration (if using)
# DATABASE_URL=your-database-connection-string

# Optional Kea chat reliability budgets (ms). Production is safe without these.
# Invalid / negative / out-of-range values fall back to the defaults below.
# KEA_CHAT_AZURE_TIMEOUT_MS=25000
# KEA_MACRO_TIMEOUT_MS=15000
# KEA_CHAT_BUDGET_MS=60000
# KEA_REDIS_COMMAND_TIMEOUT_MS=8000
# KEA_AUTH_DB_TIMEOUT_MS=5000

# Phase 3B.3A / 3B.4: approved macro Azure evidence uses Ledger → Prompt View
# when unset, true, 1, on, or yes. Set 0/false/off/no to roll back to
# azureFacingEvidence. Unknown values are treated as enabled.
# USE_EVIDENCE_LEDGER_PROMPT=true 